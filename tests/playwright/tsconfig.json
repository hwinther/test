{
  "extends": "@wshno/tsconfig/node.json",
  "compilerOptions": {
    // The suite is CommonJS (no "type": "module"), which verbatimModuleSyntax rejects ESM syntax in.
    "verbatimModuleSyntax": false,
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "paths": {
      "~pages/*": ["./pages/*"],
      "~tests/*": ["./tests/*"]
    },
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowJs": true,
    "noEmit": true
  },
  "include": ["tests", "eslint.config.mjs", "playwright.config.ts", "environment.d.ts"],
  "exclude": ["node_modules", "playwright-report", "test-results"]
}
