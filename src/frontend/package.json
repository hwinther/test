{
  "name": "test-frontend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:ci": "eslint . --report-unused-disable-directives --format json",
    "lint/fix": "eslint . --fix",
    "format/check": "prettier . --check",
    "format/fix": "prettier . --write",
    "orval": "orval --config ./orval.config.cjs",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "coverage:ci": "vitest run --coverage"
  },
  "prettier": "@wshno/prettier-config",
  "dependencies": {
    "@microsoft/signalr": "10.0.11",
    "@opentelemetry/api": "1.10.0",
    "@react-router/node": "8.5.1",
    "@react-router/serve": "8.5.1",
    "@tailwindcss/vite": "4.3.4",
    "@tanstack/react-query": "5.106.1",
    "@tanstack/react-query-devtools": "5.106.1",
    "@wshno/otel": "0.2.0",
    "axios": "1.21.0",
    "isbot": "5.2.2",
    "oidc-client-ts": "^3.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-oidc-context": "^3.3.1",
    "react-router": "8.5.1",
    "redis": "^6.3.0",
    "tailwindcss": "4.3.4"
  },
  "devDependencies": {
    "@cspell/eslint-plugin": "10.4.0",
    "@faker-js/faker": "10.6.0",
    "@react-router/dev": "8.5.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-istanbul": "5.1.0",
    "@vitest/ui": "5.1.0",
    "@wshno/eslint-config": "0.2.0",
    "@wshno/prettier-config": "0.1.1",
    "@wshno/tsconfig": "0.1.1",
    "eslint": "10.14.0",
    "eslint-plugin-jsdoc": "65.4.4",
    "jsdom": "31.0.0",
    "msw": "3.0.3",
    "openapi-types": "12.1.3",
    "orval": "8.46.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vite-plugin-mkcert": "2.1.0",
    "vitest": "5.1.0"
  }
}
