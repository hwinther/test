{
  "name": "test-frontend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:ci": "eslint . --report-unused-disable-directives --format json",
    "lint/fix": "eslint . --fix",
    "format/check": "prettier . --check",
    "format/fix": "prettier . --write",
    "orval": "orval --config ./orval.config.cjs",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "coverage:ci": "vitest run --coverage"
  },
  "dependencies": {
    "@microsoft/signalr": "10.0.11",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/auto-instrumentations-node": "0.81.0",
    "@opentelemetry/auto-instrumentations-web": "0.68.0",
    "@opentelemetry/context-zone": "2.12.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.223.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/instrumentation": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-logs": "0.223.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@opentelemetry/sdk-trace-web": "2.12.0",
    "@opentelemetry/semantic-conventions": "1.44.0",
    "@react-router/node": "7.18.5",
    "@react-router/serve": "7.18.5",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.105.0",
    "@tanstack/react-query-devtools": "5.105.0",
    "axios": "1.21.0",
    "isbot": "5.2.2",
    "oidc-client-ts": "^3.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-oidc-context": "^3.3.1",
    "react-router": "7.18.5",
    "redis": "^5.12.1",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@cspell/eslint-plugin": "9.8.0",
    "@eslint/js": "9.39.5",
    "@faker-js/faker": "10.6.0",
    "@react-router/dev": "7.18.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "@vitest/coverage-istanbul": "4.1.12",
    "@vitest/ui": "4.1.12",
    "eslint": "9.39.5",
    "eslint-config-love": "140.0.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-formatter-compact": "9.0.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "61.7.1",
    "eslint-plugin-n": "17.24.0",
    "eslint-plugin-perfectionist": "5.13.0",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-sonarjs": "3.0.7",
    "jsdom": "29.1.1",
    "msw": "2.15.0",
    "openapi-types": "12.1.3",
    "orval": "8.45.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vite-plugin-mkcert": "2.1.0",
    "vitest": "4.1.12"
  }
}
