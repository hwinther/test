{
  "extends": "@wshno/tsconfig/react-router.json",
  "include": ["**/*", "**/.server/**/*", "**/.client/**/*", ".react-router/types/**/*"],
  "compilerOptions": {
    "types": ["node", "vite/client", "vitest/globals"],
    "rootDirs": [".", "./.react-router/types"],
    "paths": {
      "~/*": ["./app/*"],
      "~test/*": ["./test/*"]
    },
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowJs": true,
    "noUncheckedIndexedAccess": false
  }
}
